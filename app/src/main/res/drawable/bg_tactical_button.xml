<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable surface: one step lighter than a static panel plus a brighter edge,
     so interactive rows read as controls instead of cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/buttonBackgroundColor" />
    <stroke
        android:width="1dp"
        android:color="?attr/buttonBorderColor" />
    <corners android:radius="16dp" />
</shape>
