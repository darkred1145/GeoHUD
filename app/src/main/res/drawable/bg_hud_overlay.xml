<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:top="0dp" android:left="0dp" android:width="56dp" android:height="56dp">
        <shape>
            <corners android:radius="6dp" />
            <stroke android:width="4dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>

    <item android:top="0dp" android:right="0dp" android:width="56dp" android:height="56dp" android:gravity="right">
        <shape>
            <corners android:radius="6dp" />
            <stroke android:width="4dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>

    <item android:bottom="0dp" android:left="0dp" android:width="56dp" android:height="56dp" android:gravity="bottom">
        <shape>
            <corners android:radius="6dp" />
            <stroke android:width="4dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>

    <item android:bottom="0dp" android:right="0dp" android:width="56dp" android:height="56dp" android:gravity="bottom|right">
        <shape>
            <corners android:radius="6dp" />
            <stroke android:width="4dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>

    <item android:width="40dp" android:height="40dp" android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>

    <item android:width="8dp" android:height="8dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="?attr/colorPrimary" />
        </shape>
    </item>

</layer-list>
