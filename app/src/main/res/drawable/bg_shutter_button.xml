<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item
                android:width="76dp"
                android:height="76dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <stroke
                        android:width="2dp"
                        android:color="#B3FFFFFF" />
                </shape>
            </item>
            <item
                android:width="58dp"
                android:height="58dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="?attr/colorPrimary" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item
                android:width="76dp"
                android:height="76dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <stroke
                        android:width="2dp"
                        android:color="#F2FFFFFF" />
                </shape>
            </item>
            <item
                android:width="58dp"
                android:height="58dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="?attr/colorPrimary" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
