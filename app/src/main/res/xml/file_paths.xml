<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App-specific external storage (legacy captures). -->
    <external-files-path
        name="app_pictures"
        path="Pictures/" />

    <!-- Downloaded update APK. -->
    <external-files-path
        name="app_downloads"
        path="Download/" />

    <!-- Legacy public captures on API 26-28. Keep scope narrow. -->
    <external-path
        name="public_pictures"
        path="Pictures/GeoHUD/" />

    <!-- Temporary share/export staging. -->
    <cache-path
        name="cache_files"
        path="." />
</paths>
